{
   "model_id": "Qwen/Qwen2.5-1.5B",
   "dataset_url": "https://raw.githubusercontent.com/AGI-Edgerunners/LLM-Adapters/main/ft-training_set/commonsense_170k.json",
   "output_dir": "./qwen2.5-1.5b-lora-commonsense",
   "use_dora": false,
   "skip_test": false,
   "quantization": {
       "bits": 4,
        "quant_type": "nf4",
        "double_quant": true
    },
    "lora": {
        "r": 16,
        "lora_alpha": 32,
        "target_modules": ["q_proj", "k_proj", "v_proj", "up_proj", "down_proj"],
        "lora_dropout": 0.05,
        "bias": "none",
        "task_type": "CAUSAL_LM"
    },
    "training": {
        "per_device_train_batch_size": 8,
        "gradient_accumulation_steps": 2,
        "optim": "adamw_torch",
        "learning_rate": 2e-4,
        "lr_scheduler_type": "linear",
        "num_train_epochs": 3,
        "warmup_steps": 100,
        "logging_steps": 50,
        "save_steps": 500,
        "save_total_limit": 3,
        "bf16": true,
        "max_grad_norm": 0.3,
        "max_length": 512,
        "seed": 42,
        "resume_from_checkpoint": false
    }
}