{
    "model_id": "meta-llama/Meta-Llama-3.1-8B",
    "dataset_url": "https://raw.githubusercontent.com/AGI-Edgerunners/LLM-Adapters/main/ft-training_set/commonsense_170k.json",
    "output_dir": "./meta-llama-8b-lora-commonsense",
    "use_dora": false,
    "skip_test": false,

    "quantization": {
        "bits": 4
    },

    "lora": {
        "r": 16,
        "lora_alpha": 32,
        "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
        "lora_dropout": 0.05,
        "bias": "none",
        "task_type": "CAUSAL_LM"
    },

    "training": {
        "per_device_train_batch_size": 4,
        "gradient_accumulation_steps": 2,
        "optim": "paged_adamw_32bit",
        "learning_rate": 2e-4,
        "lr_scheduler_type": "cosine",
        "num_train_epochs": 3,
        "warmup_ratio": 0.03,
        "logging_steps": 50,
        "save_steps": 500,
        "bf16": true,
        "max_grad_norm": 0.3,
        "max_length": 512
    }
}
