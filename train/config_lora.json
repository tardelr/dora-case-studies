{
  "model_id": "meta-llama/Llama-3-8B",
  "dataset_url": "https://raw.githubusercontent.com/AGI-Edgerunners/LLM-Adapters/main/ft-training_set/commonsense_170k.json",
  "output_dir": "./llama3-8b-lora-commonsense",
  "use_dora": false,
  "skip_test": false,
  "quantization": null,
  "lora": {
    "r": 32,
    "lora_alpha": 32,
    "target_modules": ["q_proj", "k_proj", "v_proj", "up_proj", "down_proj"],
    "lora_dropout": 0.05,
    "bias": "none",
    "task_type": "CAUSAL_LM"
  },
  "training": {
    "per_device_train_batch_size": 16,
    "gradient_accumulation_steps": 1,
    "optim": "adamw_torch",
    "learning_rate": 1e-4,
    "lr_scheduler_type": "linear",
    "num_train_epochs": 3,
    "warmup_steps": 100,
    "logging_steps": 50,
    "save_steps": 500,
    "save_total_limit": 3,
    "bf16": true,
    "fp16": false,
    "max_grad_norm": 0.3,
    "max_length": 512,
    "seed": 42,
    "resume_from_checkpoint": false
  },
  "eval": {
    "tasks": ["boolq", "piqa", "hellaswag", "winogrande", "arc_easy", "arc_challenge", "openbookqa"],
    "num_fewshot": 0,
    "limit": null,
    "batch_size": 16
  }
}
